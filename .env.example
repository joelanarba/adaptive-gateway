# Disposable local development only. Never use these values in production.
# App
ENVIRONMENT=development
SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32

# Database
POSTGRES_USER=gateway
POSTGRES_PASSWORD=gateway
POSTGRES_DB=gateway
DATABASE_URL=postgresql+asyncpg://gateway:gateway@postgres:5432/gateway

# Redis
REDIS_URL=redis://redis:6379

# Network quality thresholds (ms)
RTT_GOOD_THRESHOLD_MS=150
RTT_DEGRADED_THRESHOLD_MS=500

# AWS 
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=

# Grafana
GRAFANA_PASSWORD=admin

# CORS (JSON array)
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Upstream services (JSON map of name → base URL)
# Example: {"jsonplaceholder": "https://jsonplaceholder.typicode.com"}
UPSTREAM_SERVICES={}
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8000

# Identity uses the socket unless the peer belongs to an explicitly trusted CIDR.
TRUSTED_PROXY_NETWORKS=[]
ALLOW_UNLISTED_UPSTREAMS=false
RATE_LIMIT_ENABLED=false
MAX_REQUEST_BODY_BYTES=1048576
MAX_RESPONSE_BODY_BYTES=8388608

